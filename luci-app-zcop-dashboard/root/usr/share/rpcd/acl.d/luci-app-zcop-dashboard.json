{
 "luci-app-zcop-dashboard": {
  "description": "Read lightweight router dashboard snapshots",
  "read": {
   "ubus": {
    "system": [ "info", "board" ],
    "network.interface": [ "dump" ],
    "network.device": [ "status" ],
    "luci-rpc": [ "getNetworkDevices", "getWirelessDevices", "getDHCPLeases" ],
    "luci": [ "getMountPoints" ],
    "file": [ "read" ]
   },
   "file": {
    "/proc/cpuinfo": [ "read" ],
    "/sys/devices/system/cpu/present": [ "read" ],
    "/sys/devices/system/cpu/cpufreq/policy0/cpuinfo_max_freq": [ "read" ],
    "/proc/stat": [ "read" ],
    "/sys/kernel/debug/ecm/ecm_nss_ipv4/accelerated_count": [ "read" ],
    "/sys/kernel/debug/ecm/ecm_nss_ipv6/accelerated_count": [ "read" ]
   }
  }
 }
}
